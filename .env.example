# Production Environment Configuration
# Rename this file to .env or pass these as environment variables when running the built app

# Google API Keys (Required for Web Speech API in production)
# Get these from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_API_KEY=your_api_key_here
GOOGLE_DEFAULT_CLIENT_ID=your_client_id_here
GOOGLE_DEFAULT_CLIENT_SECRET=your_client_secret_here
