# Firebase Configuration
# Get these values from Firebase Console > Project Settings > General
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:your-app-id

# App Check (Optional but recommended for production)
# For development: Use debug token from Firebase Console > App Check > Apps > Debug token
# For production: Use reCAPTCHA Enterprise site key
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# ==== LLM CONFIGURATION (Optional Fallbacks) ====
# Values here are used as fallbacks if not configured in the App UI Settings.

# Default Provider (when "auto" is selected in the UI)
# Options: openai, gemini, openrouter, ollama, browser
# VITE_LLM_PROVIDER=gemini

# Generic configuration (applies to whatever provider is active)
# VITE_LLM_API_KEY=your-generic-api-key
# VITE_LLM_MODEL=your-generic-model-id

# --- Provider Specific Configuration ---
# These take precedence over the generic keys above.

# Gemini
# VITE_GEMINI_API_KEY=your-google-api-key
# VITE_GEMINI_MODEL=gemini-1.5-flash

# OpenAI
# VITE_OPENAI_API_KEY=your-openai-api-key
# VITE_OPENAI_MODEL=gpt-4o

# OpenRouter
# VITE_OPENROUTER_API_KEY=your-openrouter-api-key
# VITE_OPENROUTER_MODEL=qwen/qwen3.6-plus:free

# Ollama
# VITE_OLLAMA_MODEL=llama3.2
